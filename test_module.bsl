// Простой BSL модуль для тестирования
Процедура ПроверочнаяПроцедура()
    Переменная Контрагент;
    Контрагент = Справочники.Контрагенты.НайтиПоКоду("001");
    
    Если Контрагент.Пустая() Тогда
        Сообщить("Контрагент не найден");
    Иначе
        Сообщить("Найден: " + Контрагент.Наименование);
    КонецЕсли;
КонецПроцедуры

Функция ВычислитьСумму(Сумма1, Сумма2)
    Результат = Сумма1 + Сумма2;
    Возврат Результат;
КонецФункции
