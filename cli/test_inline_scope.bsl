// Тестовый файл для Milestone 2.9: Inline Scope Analysis
// Задача: проверить, что hover корректно показывает типы локальных переменных

Процедура ТестИнлайнСкопАнализа()

    // Тест 1: Простое присваивание с конструктором "Новый"
    МассивДанных = Новый Массив();
    // Ожидаем: hover на "МассивДанных" показывает "Тип: Массив" + методы Добавить(), Очистить(), и т.д.

    // Тест 2: Присваивание с вызовом конструктора
    СтруктураДанных = Новый Структура();
    // Ожидаем: hover на "СтруктураДанных" показывает "Тип: Структура" + методы Вставить(), Свойство(), и т.д.

    // Тест 3: Присваивание объекта платформы
    ТаблицаЗначений = Новый ТаблицаЗначений();
    // Ожидаем: hover на "ТаблицаЗначений" показывает "Тип: ТаблицаЗначений" + методы Добавить(), ДобавитьКолонку(), и т.д.

    // Тест 4: Локальная переменная с явным типом (если BSL поддерживает)
    // Строковая = "Тест";
    // Ожидаем: hover на "Строковая" показывает "Тип: Строка"

    // Тест 5: Вызов метода на локальной переменной
    МассивДанных.Добавить(123);
    // Ожидаем: hover на "МассивДанных" перед точкой показывает методы

    // Тест 6: Nested scope (внутренняя функция)
    Функция ВнутренняяФункция()
        Локальный = Новый СписокЗначений();
        // Ожидаем: hover на "Локальный" показывает "Тип: СписокЗначений"
        Возврат Локальный;
    КонецФункции

    // Тест 7: Переменная после вызова функции
    Результат = ВнутренняяФункция();
    // Ожидаем: hover на "Результат" показывает тип возврата (если IR анализирует)

КонецПроцедуры
