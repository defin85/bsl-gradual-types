// Тест Milestone 3.11: Context-Aware Facet Selection
// Демонстрирует все возможности фасетной системы типов

// ========================================
// 1. MANAGER FACET (PropertyAccess)
// ========================================

Функция ТестManagerFacet()
    // PropertyAccess -> Manager facet
    СправочникМенеджер = Справочники.Контрагенты;
    ДокументМенеджер = Документы.ЗаказКлиента;

    // Hover должен показать:
    // - Тип: СправочникМенеджер.Контрагенты
    // - Фасет: Менеджер (создание, поиск элементов)
    // - Доступные методы (Manager facet):
    //   - СоздатьЭлемент() -> СправочникОбъект (Server)
    //   - НайтиПоКоду(Код) -> СправочникСсылка (Server)
    //   - Выбрать() -> СправочникВыборка (Server)
    //   - ПустаяСсылка() -> СправочникСсылка (Universal)

    Возврат СправочникМенеджер;
КонецФункции

// ========================================
// 2. FACET SWITCHING (Method Calls)
// ========================================

Функция ТестFacetSwitching()
    М = Справочники.Контрагенты;  // Manager facet

    // СоздатьЭлемент() -> Object facet
    Объект = М.СоздатьЭлемент();
    // Hover: СправочникОбъект.Контрагенты
    // Фасет: Объект (изменяемый объект)

    // НайтиПоКоду() -> Reference facet
    Ссылка = М.НайтиПоКоду("000001");
    // Hover: СправочникСсылка.Контрагенты
    // Фасет: Ссылка (ссылка на элемент)

    // Выбрать() -> Selection facet
    Выборка = М.Выбрать();
    // Hover: СправочникВыборка.Контрагенты
    // Фасет: Выборка (обход элементов)

    // ПустаяСсылка() -> Reference facet (Universal)
    ПустаяСсылка = М.ПустаяСсылка();
    // Hover: СправочникСсылка.Контрагенты (Universal)

    Возврат Объект;
КонецФункции

// ========================================
// 3. CONTEXT VALIDATION (Compiler Directives)
// ========================================

&НаСервере
Процедура СерверныйКонтекст()
    // OK: ServerOnly методы доступны на сервере

    М = Справочники.Контрагенты;

    // Все методы работают
    Объект = М.СоздатьЭлемент();           // OK
    Ссылка = М.НайтиПоКоду("001");         // OK
    Выборка = М.Выбрать();                 // OK

    Объект.Наименование = "ООО Рога и Копыта";
    Объект.Записать();                      // OK: ServerOnly
КонецПроцедуры

&НаКлиенте
Процедура КлиентскийКонтекст()
    // WARNING: ServerOnly методы недоступны на клиенте

    М = Справочники.Контрагенты;           // OK: Manager facet универсален

    // WARNING: НайтиПоКоду недоступен в контексте &НаКлиенте
    Ссылка = М.НайтиПоКоду("001");

    // WARNING: СоздатьЭлемент недоступен в контексте &НаКлиенте
    Объект = М.СоздатьЭлемент();

    // WARNING: Выбрать недоступен в контексте &НаКлиенте
    Выборка = М.Выбрать();

    // OK: ПустаяСсылка доступна везде (Universal)
    ПустаяСсылка = М.ПустаяСсылка();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СерверБезКонтекста()
    // OK: ServerOnly методы доступны
    М = Справочники.Контрагенты;
    СсылкаНаКонтрагента1 = М.НайтиПоКоду1("001");         // OK
    СсылкаНаКонтрагента2 = М.НайтиПоКоду("001");         // OK

    ТаблЗнч = Новый ТаблицаЗначений;
    ТаблЗнч.НетСвойства.Добавить();

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УниверсальныйКонтекст()
    // WARNING: ServerOnly методы недоступны в универсальном контексте
    М = Справочники.Контрагенты;

    // WARNING: НайтиПоКоду недоступен
    Ссылка = М.НайтиПоКоду("ввв");

    // OK: Universal методы работают
    ПустаяСсылка = М.ПустаяСсылка();
КонецПроцедуры

// ========================================
// 4. ДОКУМЕНТЫ (Documents)
// ========================================

Функция ТестДокументы()
    // Manager facet для документов
    ДокМенеджер = Документы.ЗаказКлиента;

    Перем ДатаДок;

    // Object facet
    ДокОбъект = ДокМенеджер.СоздатьДокумент();

    // Reference facet
    ДокСсылка = ДокМенеджер.НайтиПоНомеру("ЗК-001");

    // Документ специфичные методы
    ДокОбъект.Провести();                  // ServerOnly
    ДокОбъект.ОтменитьПроведение();        // ServerOnly

    ДокЗаказНарядыМенеджер = Документы.ЗаказНаряды;
    ДокЗаказНарядыСсылка = Документы.ЗаказНаряды.НайтиПоНомеру("ввв");
    ДокЗаказНарядыСсылка1 = ДокЗаказНарядыМенеджер.НайтиПоНомеру("ввв", ДатаДок);
    ДокЗаказНарядыСсылка.Работы.Выгрузить();

    Возврат ДокОбъект;
КонецФункции

// ========================================
// 5. ЦЕПОЧКИ МЕТОДОВ (Method Chains)
// ========================================

Функция ТестЦепочкиМетодов()
    // Manager -> Object -> void
    Справочники.Контрагенты.СоздатьЭлемент().Записать();

    // Manager -> Reference -> Object
    ПолученныйОбъект = Справочники.Контрагенты.НайтиПоКоду("001").ПолучитьОбъект();
    // делаем что-то с объектом справочника
    ПолученныйОбъект = Документы.ЗаказНаряды.НайтиПоНомеру("001").ПолучитьОбъект();
    // делаем что-то с объектом документа
    //ПолученныйОбъект = Справочники.Контрагенты.НеСуществующийМетод("001").ПолучитьОбъект();

    Возврат ПолученныйОбъект;
КонецФункции
