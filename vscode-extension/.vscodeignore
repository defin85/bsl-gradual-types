# Source files
src/**
**/*.ts
!out/**/*.js

# Development files
.vscode/
.vscode-test/
.gitignore
.git/
.github/

# Test files
test/**
**/*.test.ts
**/*.spec.ts

# Build artifacts
*.map
tsconfig.json
tsconfig.*.json

# Documentation
*.md
!README.md
!CHANGELOG.md

# Dependencies - exclude node_modules from VSIX
node_modules/**

# Binaries - ONLY include LSP server
# All other binaries are removed, keep only:
# - bin/lsp_server.exe (7.7 MB)
# - bin/lsp_server_wrapper.bat
# - bin/README.md

# Misc
.eslintrc.json
.prettierrc
*.log
*.vsix
package-lock.json

# Images - keep only necessary ones
images/**
!images/bsl-analyzer-logo.png
