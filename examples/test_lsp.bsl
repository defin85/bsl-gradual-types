// Тестовый файл для проверки LSP сервера BSL Gradual Types

Функция ТестМассива()
    // Тест валидации методов массива
    МойМассив = Новый Массив();

    // ✅ Валидный метод - должен работать автодополнение
    МойМассив.Добавить("элемент");
    МойМассив.Количество();
    МойМассив.Очистить();

    // ❌ Несуществующий метод - должна быть диагностика об ошибке
    МойМассив.НесуществующийМетод();

КонецФункции

Функция ТестТаблицыЗначений()
    // Тест валидации свойств и методов ТаблицаЗначений
    Таблица = Новый ТаблицаЗначений();

    // ✅ Валидные свойства
    Колонки = Таблица.Колонки;
    Индексы = Таблица.Индексы;

    // ✅ Валидные методы
    Таблица.Добавить();
    Таблица.Вставить(0);
    Таблица.Очистить();

    // ❌ Несуществующий метод
    Таблица.ВыдуманныйМетод();

    // ❌ Несуществующее свойство
    НеСуществует = Таблица.НесуществующееСвойство;

КонецФункции

Функция ТестАнглийскихИмен()
    // Тест поддержки английских имён методов
    Arr = Новый Массив();

    // ✅ Английские имена методов (case-insensitive)
    Arr.Add("item");
    Arr.Count();
    Arr.Clear();

    // ✅ Смешанный регистр
    Arr.add("item2");
    Arr.ADD("item3");

КонецФункции

Функция ТестHover()
    // Тест hover-подсказок о типах
    МойМассив = Новый Массив();
    Таблица = Новый ТаблицаЗначений();

    // При наведении на МойМассив должна показаться информация о типе Массив
    // При наведении на Таблица должна показаться информация о типе ТаблицаЗначений

    Возврат МойМассив;
КонецФункции
