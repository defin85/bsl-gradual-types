Функция ТестДокументы()
    Перем ТестПерем;
    
    // Manager facet для документов
    ДокМенеджер = Документы.ЗаказКлиента;

    Перем ДатаДок;

    // Object facet
    ДокОбъект = ДокМенеджер.СоздатьДокумент();

    // Reference facet
    ДокСсылка = ДокМенеджер.НайтиПоНомеру("ЗК-001");

    // Документ специфичные методы
    ДокОбъект.Провести();                  // ServerOnly
    ДокОбъект.ОтменитьПроведение();        // ServerOnly

    ДокЗаказНарядыМенеджер = Документы.ЗаказНаряды;
    ДокЗаказНарядыСсылка = Документы.ЗаказНаряды.НайтиПоНомеру("ввв");
    ДокЗаказНарядыСсылка1 = ДокЗаказНарядыМенеджер.НайтиПоНомеру("ввв", ДатаДок);
    ТабличнаяЧастьРаботы = ДокЗаказНарядыСсылка.Работы;
    ТаблЗначРаботы2 = ТабличнаяЧастьРаботы.Выгрузить();
    ТаблЗначРаботы = ДокЗаказНарядыСсылка.Работы.Выгрузить();

    Возврат ДокОбъект;
КонецФункции
