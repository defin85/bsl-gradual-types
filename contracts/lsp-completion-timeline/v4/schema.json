{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lsp-completion-timeline contract v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "surface",
    "major_version",
    "schema_version",
    "compatibility",
    "request",
    "response"
  ],
  "properties": {
    "surface": {
      "type": "string",
      "const": "lsp-completion-timeline"
    },
    "major_version": {
      "type": "integer",
      "const": 4
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "breaking_change_requires_major_bump",
        "breaking_change_requires_migration_note"
      ],
      "properties": {
        "breaking_change_requires_major_bump": {
          "type": "boolean",
          "const": true
        },
        "breaking_change_requires_migration_note": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "command",
        "params_shape"
      ],
      "properties": {
        "method": {
          "type": "string",
          "const": "workspace/executeCommand"
        },
        "command": {
          "type": "string",
          "const": "bsl.getCompletionTimeline"
        },
        "params_shape": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "optional_fields",
            "limit_bounds"
          ],
          "properties": {
            "optional_fields": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "limit",
                  "request_id"
                ]
              }
            },
            "limit_bounds": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minimum",
                "maximum",
                "default"
              ],
              "properties": {
                "minimum": {
                  "type": "integer",
                  "const": 1
                },
                "maximum": {
                  "type": "integer",
                  "const": 200
                },
                "default": {
                  "type": "integer",
                  "const": 200
                }
              }
            }
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "retention_max_entries_default",
        "trace_fields",
        "prepare_details_fields",
        "turn_attribution_fields",
        "turn_holder_fields",
        "stage_fields",
        "stage_statuses",
        "prepare_routes",
        "prepare_fail_closed_causes",
        "outcomes"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 2
        },
        "retention_max_entries_default": {
          "type": "integer",
          "const": 200
        },
        "trace_fields": {
          "type": "array",
          "minItems": 11,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "trace_id",
              "request_id",
              "uri",
              "trigger_mode",
              "outcome",
              "started_at_ms",
              "total_duration_ms",
              "dominant_stage",
              "prepare_details",
              "turn_attribution",
              "stages"
            ]
          }
        },
        "prepare_details_fields": {
          "type": "array",
          "minItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "wait_budget_ms",
              "guard_outcome",
              "outcome",
              "route",
              "fail_closed_cause",
              "min_file_version",
              "shadow_version_at_start",
              "observed_file_version",
              "wait_elapsed_ms",
              "snapshot_elapsed_ms",
              "apply_age_at_start_ms",
              "apply_age_at_terminal_ms"
            ]
          }
        },
        "turn_attribution_fields": {
          "type": "array",
          "minItems": 13,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "request_file_seq",
              "request_epoch",
              "queue_outcome",
              "turn_wait_outcome",
              "queue_capacity",
              "queue_depth_before_enqueue",
              "queue_depth_after_enqueue",
              "queued_completion_ahead_count",
              "did_change_ahead_count",
              "active_completion_count",
              "dropped_completion_file_seq",
              "active_holder",
              "queued_completion_ahead"
            ]
          }
        },
        "turn_holder_fields": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "request_id",
              "file_seq",
              "request_epoch",
              "trigger_mode",
              "version_hint",
              "age_ms"
            ]
          }
        },
        "stage_fields": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "name",
              "status",
              "started_offset_ms",
              "duration_ms"
            ]
          }
        },
        "stage_statuses": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "completed",
              "cancelled",
              "failed",
              "skipped"
            ]
          }
        },
        "prepare_routes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "head_hit",
              "exact_hit"
            ]
          }
        },
        "prepare_fail_closed_causes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "prepare_timeout",
              "exact_deadline"
            ]
          }
        },
        "outcomes": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "ok_non_empty",
              "ok_empty",
              "fail_closed",
              "cancelled",
              "superseded",
              "handler_error"
            ]
          }
        }
      }
    }
  }
}
