// Тестовый файл для функционального тестирования HoverFormatter
// Используется для проверки hover через LSP Server

Процедура ТестироватьHoverFormatter()
    // Базовые типы платформы
    Строка1 = "текст";
    Число1 = 42;
    Булево1 = Истина;
    Дата1 = ТекущаяДата();

    // Generic типы - Массив
    МассивДанных = Новый Массив();
    МассивДанных.Добавить("текст");
    МассивДанных.Добавить("ещё текст");

    МассивЧисел = Новый Массив();
    МассивЧисел.Добавить(100);
    МассивЧисел.Добавить(200);

    // Generic типы - Соответствие
    Карта = Новый Соответствие();
    Карта.Вставить("ключ", 100);
    Карта.Вставить("другой_ключ", 200);

    // Пустые коллекции (тип элемента Unknown)
    ПустойМассив = Новый Массив();
    ПустоеСоответствие = Новый Соответствие();

    // Configuration типы (если метаданные не загружены - должен показывать предупреждение)
    Контрагенты = Справочники.Контрагенты;
    Документы = Документы.РеализацияТоваровУслуг;

    // Сложные выражения
    Результат = МассивДанных.Количество();
    Значение = Карта.Получить("ключ");

КонецПроцедуры

// Тест для hover на параметрах функции
Функция ВычислитьСумму(Первое, Второе)
    // Hover на "Первое" должен показать тип параметра (если можем вывести)
    Локальная = Первое + Второе;
    Возврат Локальная;
КонецФункции

// Тест для hover на имени функции
Функция ПолучитьМассив()
    МассивРезультат = Новый Массив();
    МассивРезультат.Добавить("элемент");
    Возврат МассивРезультат;
КонецФункции
