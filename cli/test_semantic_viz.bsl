// Тестовый файл для демонстрации семантической визуализации
// Milestone 2.12: Real-time Semantic Tree Visualization

Перем ГлобальнаяПеременная Экспорт;

Процедура ОбработатьДанные(Параметр1, Параметр2) Экспорт
    МассивДанных = Новый Массив();
    МассивДанных.Добавить(Параметр1);
    МассивДанных.Добавить(Параметр2);

    Для Каждого Элемент Из МассивДанных Цикл
        Если Элемент <> Неопределено Тогда
            Сообщить(Элемент);
        КонецЕсли;
    КонецЦикла;

    Результат = ВычислитьСумму(Параметр1, Параметр2);
    Возврат Результат;
КонецПроцедуры

Функция ВычислитьСумму(Число1, Число2)
    Сумма = Число1 + Число2;
    Возврат Сумма;
КонецФункции

Функция ПолучитьСправочник(Наименование)
    Попытка
        Справочник = Справочники[Наименование];
        Возврат Справочник;
    Исключение
        Сообщить("Ошибка: " + ОписаниеОшибки());
        Возврат Неопределено;
    КонецПопытки;
КонецФункции
