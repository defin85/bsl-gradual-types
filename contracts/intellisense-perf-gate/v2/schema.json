{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "intellisense-perf-gate contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "surface",
    "major_version",
    "schema_version",
    "compatibility",
    "input",
    "coverage",
    "baseline",
    "report",
    "evaluator"
  ],
  "properties": {
    "surface": {
      "type": "string",
      "const": "intellisense-perf-gate"
    },
    "major_version": {
      "type": "integer",
      "const": 2
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "breaking_change_requires_major_bump",
        "breaking_change_requires_migration_note"
      ],
      "properties": {
        "breaking_change_requires_major_bump": {
          "type": "boolean",
          "const": true
        },
        "breaking_change_requires_migration_note": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_profiles",
        "required_operation_matrix",
        "required_latency_metric_families",
        "required_resource_metric_families"
      ],
      "properties": {
        "required_profiles": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "small",
              "large",
              "churn"
            ]
          }
        },
        "required_operation_matrix": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "steady_member_chain",
            "post_did_change_current_revision",
            "object_module_explicit_context",
            "recordset_module_explicit_context",
            "incomplete_syntax_member_access"
          ],
          "properties": {
            "steady_member_chain": {
              "type": "array",
              "minItems": 5,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "completion",
                  "hover",
                  "definition",
                  "type_at_position",
                  "members"
                ]
              }
            },
            "post_did_change_current_revision": {
              "type": "array",
              "minItems": 5,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "completion",
                  "hover",
                  "definition",
                  "type_at_position",
                  "members"
                ]
              }
            },
            "object_module_explicit_context": {
              "type": "array",
              "minItems": 5,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "completion",
                  "hover",
                  "definition",
                  "type_at_position",
                  "members"
                ]
              }
            },
            "recordset_module_explicit_context": {
              "type": "array",
              "minItems": 5,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "completion",
                  "hover",
                  "definition",
                  "type_at_position",
                  "members"
                ]
              }
            },
            "incomplete_syntax_member_access": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "completion"
                ]
              }
            }
          }
        },
        "required_latency_metric_families": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "total_duration_ms",
              "wait_for_file_version_ms",
              "snapshot_preparation_ms",
              "ir_query_ms"
            ]
          }
        },
        "required_resource_metric_families": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "allocations_per_request",
              "allocated_bytes_per_request",
              "lock_wait_ms_per_request",
              "lock_contention_events_per_request"
            ]
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_coverage_mode",
        "reported_operations",
        "reported_fixture_families",
        "authoritative_for_cutover_acceptance"
      ],
      "properties": {
        "operation_coverage_mode": {
          "type": "string",
          "const": "representative_matrix"
        },
        "reported_operations": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "completion",
              "hover",
              "definition",
              "type_at_position",
              "members"
            ]
          }
        },
        "reported_fixture_families": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "steady_member_chain",
              "post_did_change_current_revision",
              "object_module_explicit_context",
              "recordset_module_explicit_context",
              "incomplete_syntax_member_access"
            ]
          }
        },
        "authoritative_for_cutover_acceptance": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "absolute_latency_ceilings_ms",
        "resource_budget_ceilings",
        "fail_closed_budget_ceilings",
        "relative_ratio_baseline_floors",
        "anti_rescue_budget_ceilings",
        "bootstrap_policy"
      ],
      "properties": {
        "absolute_latency_ceilings_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "small",
            "large",
            "churn"
          ],
          "properties": {
            "small": {
              "$ref": "#/$defs/profileLatencyBudget"
            },
            "large": {
              "$ref": "#/$defs/profileLatencyBudget"
            },
            "churn": {
              "$ref": "#/$defs/profileLatencyBudget"
            }
          }
        },
        "resource_budget_ceilings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "small",
            "large",
            "churn"
          ],
          "properties": {
            "small": {
              "$ref": "#/$defs/profileResourceBudget"
            },
            "large": {
              "$ref": "#/$defs/profileResourceBudget"
            },
            "churn": {
              "$ref": "#/$defs/profileResourceBudget"
            }
          }
        },
        "fail_closed_budget_ceilings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "small",
            "large",
            "churn"
          ],
          "properties": {
            "small": {
              "$ref": "#/$defs/profileFailClosedBudget"
            },
            "large": {
              "$ref": "#/$defs/profileFailClosedBudget"
            },
            "churn": {
              "$ref": "#/$defs/profileFailClosedBudget"
            }
          }
        },
        "relative_ratio_baseline_floors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total_duration_ms",
            "wait_for_file_version_ms",
            "snapshot_preparation_ms",
            "ir_query_ms",
            "allocations_per_request",
            "allocated_bytes_per_request",
            "lock_wait_ms_per_request",
            "lock_contention_events_per_request"
          ],
          "properties": {
            "total_duration_ms": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "wait_for_file_version_ms": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "snapshot_preparation_ms": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "ir_query_ms": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "allocations_per_request": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "allocated_bytes_per_request": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "lock_wait_ms_per_request": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "lock_contention_events_per_request": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "anti_rescue_budget_ceilings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stale_fallback_total",
            "stale_served_total",
            "degraded_substitute_total",
            "search_backed_substitute_total"
          ],
          "properties": {
            "stale_fallback_total": {
              "type": "integer",
              "const": 0
            },
            "stale_served_total": {
              "type": "integer",
              "const": 0
            },
            "degraded_substitute_total": {
              "type": "integer",
              "const": 0
            },
            "search_backed_substitute_total": {
              "type": "integer",
              "const": 0
            }
          }
        },
        "bootstrap_policy": {
          "$ref": "#/$defs/bootstrapPolicy"
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_fields",
        "verdict_enum"
      ],
      "properties": {
        "required_fields": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "contract_version",
              "profile",
              "coverage",
              "results",
              "verdict",
              "reason_codes"
            ]
          }
        },
        "verdict_enum": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ]
          }
        },
        "optional_provenance_fields": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "change_id",
              "generated_at",
              "profile",
              "schema_version",
              "contract_version"
            ]
          }
        },
        "change_id_source_priority": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "--change-id",
              "OPENSPEC_CHANGE_ID"
            ]
          }
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason_codes"
      ],
      "properties": {
        "reason_codes": {
          "type": "array",
          "minItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "missing_required_metric_field",
              "missing_required_matrix_coverage",
              "unsupported_contract_version",
              "latency_relative_ratio_exceeded",
              "latency_absolute_ceiling_exceeded",
              "allocation_budget_exceeded",
              "lock_wait_budget_exceeded",
              "lock_contention_budget_exceeded",
              "anti_rescue_budget_exceeded",
              "fail_closed_budget_exceeded",
              "protected_acceptance_asset_modified",
              "change_criticality_missing_or_unknown",
              "test_first_evidence_missing_or_invalid",
              "initial_budget_not_fixed",
              "perf_gate_architecture_violation",
              "provenance_missing_for_authoritative_run",
              "provenance_mismatch_expected_change_id",
              "provenance_invalid",
              "provenance_non_authoritative_cutover_evidence",
              "parity_evidence_insufficient",
              "parity_drift_threshold_exceeded"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "profileLatencyBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "incomplete_syntax_member_access"
      ],
      "properties": {
        "default": {
          "type": "object"
        },
        "incomplete_syntax_member_access": {
          "type": "object"
        }
      }
    },
    "profileResourceBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "incomplete_syntax_member_access"
      ],
      "properties": {
        "default": {
          "type": "object"
        },
        "incomplete_syntax_member_access": {
          "type": "object"
        }
      }
    },
    "profileFailClosedBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "incomplete_syntax_member_access"
      ],
      "properties": {
        "default": {
          "type": "object"
        },
        "incomplete_syntax_member_access": {
          "type": "object"
        }
      }
    },
    "ceilingPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p95",
        "p99"
      ],
      "properties": {
        "p95": {
          "type": "integer",
          "minimum": 1
        },
        "p99": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "bootstrapPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_profiles",
        "sample_size_min",
        "aggregation_rule"
      ],
      "properties": {
        "required_profiles": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "small",
              "large",
              "churn"
            ]
          }
        },
        "sample_size_min": {
          "type": "integer",
          "minimum": 5
        },
        "aggregation_rule": {
          "type": "string",
          "const": "median"
        }
      }
    }
  }
}
