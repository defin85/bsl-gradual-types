// Тест Milestone 2.11: Span Extraction и Hover
// Каждая переменная должна показывать РАЗНУЮ информацию при наведении

Функция ТестСпановИHover()
    // Объявление переменных на разных строках
    Перем СправочникКонтрагенты;
    Перем ДокументЗаказ;
    Перем МассивЗначений;
    Перем СтрокаТекста;
    Перем ЧислоИтераций;

    // Присваивания с разными типами - hover должен показывать РАЗНУЮ информацию
    СправочникКонтрагенты = Справочники.Контрагенты;  // Строка 13
    ДокументЗаказ = Документы.ЗаказКлиента;            // Строка 14
    МассивЗначений = Новый Массив;                      // Строка 15
    СтрокаТекста = "Тестовая строка";                  // Строка 16
    ЧислоИтераций = 42;                                 // Строка 17

    // Проверка hover в условных операторах
    Если СправочникКонтрагенты <> Неопределено Тогда
        Сообщить("Справочник найден");
    КонецЕсли;

    // Проверка hover в циклах
    Пока ЧислоИтераций > 0 Цикл
        ЧислоИтераций = ЧислоИтераций - 1;
    КонецЦикла;

    // Возврат значения
    Возврат СправочникКонтрагенты;
КонецФункции
