{
  "mcpServers": {
    "language-server": {
      "command": "mcp-language-server",
      "args": [
        "--workspace",
        "C:\\1CProject\\bsl-gradual-types",
        "--lsp",
        "rust-analyzer"
      ]
    },
    "bsl-agent": {
      "command": "C:\\1CProject\\bsl-gradual-types\\target\\release\\bsl-agent.exe",
      "env": {
        "RUST_LOG": "bsl_agent=info",
        "BSL_AGENT_HTTP_ADDR": "127.0.0.1:0"
      }
    },
    "sourcebot": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@sourcebot/mcp@latest"
      ],
      "env": {
        "SOURCEBOT_HOST": "http://localhost:3000",
        "SOURCEBOT_API_KEY": "sourcebot-996ada359457b1e8e28e4ee23c723c13e0b410225c212d213db89d8cb6c316dc"
      }
    },
    "mcp-debug": {
      "command": "C:\\1CProject\\bsl-gradual-types\\target\\release\\mcp-debug.exe",
      "env": {
        "RUST_LOG": "mcp_debug_server=info"
      }
    }
  }
}
